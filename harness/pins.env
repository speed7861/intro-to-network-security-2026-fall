# Pinned versions — every run records these in its manifest.
CG_REPO=https://github.com/CryptoGuardOSS/cryptoguard.git
# "CG-2019": tip of the ccs-submission branch (Jan 2019), closest public code to the CCS'19 paper.
CG2019_COMMIT=4097f921
# "CG-2020": latest public release (v04.05.03, Nov 2020).
CG2020_COMMIT=92551eeb

BENCH_REPO=https://github.com/CryptoGuardOSS/cryptoapi-bench.git
# Last commit with exactly 112 test files = the version evaluated in the paper (Tables 3 and 7).
BENCH112_COMMIT=734aecb
# Later version (171 labelled cases + xlsx ground truth) — used for the extended run only.
BENCH171_COMMIT=759622f

FSB_URL=https://github.com/find-sec-bugs/find-sec-bugs/releases/download/version-1.12.0/findsecbugs-cli-1.12.0.zip
FSB_SHA256=a50bd4741a68c6886bbc03d20da9ded44bce4dd7d0d2eee19ceb338dd644cd55

JDK8=/usr/lib/jvm/java-8-openjdk-amd64
JDK21=/usr/lib/jvm/java-21-openjdk-amd64
